# Public site URL for sitemap, Open Graph, JSON-LD, and the printable credits QR (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://your-community.example

# --- Credits claim (/creditos) ---
# Never commit real Luma CSVs, emails, or credit codes. Load them via env, a gitignored file, or the admin panel.

# Organizer password for /creditos/admin and CSV export
CREDITS_ADMIN_PASSWORD=change-me

# pool = unique code/link per email (idempotent). shared = one link for every registered email.
CREDITS_MODE=pool

# Shared-mode URL shown to any eligible email
# CREDITS_SHARED_LINK=https://cursor.com/referral?code=EXAMPLE

# Inline guests CSV (Luma export). Prefer CREDITS_GUESTS_PATH or admin upload so the value stays out of the shell history.
# CREDITS_GUESTS_CSV=name,email,approval_status

# Path to a gitignored Luma guests CSV (server-side only)
# CREDITS_GUESTS_PATH=.data/luma-guests.csv

# Inline unique codes/links, one per line (pool mode)
# CREDITS_POOL=https://cursor.com/referral?code=FAKE-001

# Path to a gitignored pool file, one code or URL per line
# CREDITS_POOL_PATH=.data/credits-pool.txt

# JSON claim log. Default: .data/credits-store.json (gitignored). Use this on Node hosts (`pnpm start`).
# CREDITS_STORE_PATH=.data/credits-store.json

# Optional Vercel KV / Upstash Redis so claims survive serverless. If both URL and token are set, they win over the file store.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
