{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["nextjs", "react", "typescript", "react-perf"],
	"categories": {
		"correctness": "warn"
	},
	"ignorePatterns": [
		".next/**",
		"out/**",
		"build/**",
		"node_modules/**",
		"e2e/**",
		"playwright-report/**",
		"test-results/**"
	]
}
